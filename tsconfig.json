{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "removeComments": true,
    "noImplicitAny": false,
    "typeRoots": ["node_modules/@types", "typings"],
    "types": ["node"],
    "lib": ["es2022", "dom"],
    "allowJs": true,
    "outDir": "./js",
    "rootDir": "./ts",
    "resolveJsonModule": true,
  },
  "include": ["ts/**/*"],
  "exclude": ["node_modules"]
}